<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Sets — WeAreParty</title>

  <meta
    name="description"
    content="Descubre los sets de WeAreParty. Música electrónica, sesiones y Natural Connection."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>

    /* =========================================================
       WEAREPARTY
       SETS
    ========================================================= */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #060606;
      --surface: #0b0b0c;
      --surface-2: #101011;

      --white: #ffffff;
      --text: rgba(255,255,255,.88);
      --muted: rgba(255,255,255,.45);
      --faint: rgba(255,255,255,.20);

      --cyan: #00c8ff;
      --violet: #7b2cff;
      --magenta: #e8005a;

      --border: rgba(255,255,255,.08);

      --max: 1440px;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--white);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(var(--max), calc(100% - 80px));
      margin: 0 auto;
    }

    .eyebrow {
      font-size: 10px;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .gradient-text {
      background: linear-gradient(
        90deg,
        var(--cyan),
        var(--violet),
        var(--magenta)
      );

      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .pulse-line {
      position: fixed;
      top: 0;
      left: 0;

      width: 100%;
      height: 2px;

      z-index: 1000;

      background:
        linear-gradient(
          90deg,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );
    }


    /* =========================================================
       NAVIGATION
    ========================================================= */

    nav {
      position: relative;
      z-index: 20;

      width: 100%;
      padding: 26px 40px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      border-bottom: 1px solid var(--border);

      background: rgba(6,6,6,.65);
      backdrop-filter: blur(14px);
    }

    .logo img {
      height: 38px;
      width: auto;
      display: block;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 34px;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;

      color: var(--muted);

      transition: color .25s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--white);
    }

    .nav-button {
      padding: 10px 18px;

      border: 1px solid rgba(0,200,255,.45);

      color: var(--cyan);

      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;

      transition: all .25s ease;
    }

    .nav-button:hover {
      background: rgba(0,200,255,.08);
      border-color: var(--cyan);
    }


    /* =========================================================
       PAGE HERO
    ========================================================= */

    .page-hero {
      position: relative;

      min-height: 62vh;

      display: flex;
      align-items: center;

      overflow: hidden;

      border-bottom: 1px solid var(--border);
    }

    .page-hero-background {
      position: absolute;
      inset: 0;

      pointer-events: none;
    }

    .glow-1 {
      position: absolute;

      width: 750px;
      height: 750px;

      right: -250px;
      top: -150px;

      background:
        radial-gradient(
          circle,
          rgba(123,44,255,.18),
          transparent 68%
        );

      filter: blur(20px);
    }

    .glow-2 {
      position: absolute;

      width: 650px;
      height: 650px;

      left: -300px;
      bottom: -300px;

      background:
        radial-gradient(
          circle,
          rgba(0,200,255,.10),
          transparent 68%
        );

      filter: blur(20px);
    }

    .page-grid {
      position: absolute;
      inset: 0;

      background-image:
        linear-gradient(
          rgba(255,255,255,.018) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(255,255,255,.018) 1px,
          transparent 1px
        );

      background-size: 80px 80px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 90%
        );
    }

    .page-hero-content {
      position: relative;
      z-index: 2;

      padding: 100px 0 90px;
    }

    .page-hero-eyebrow {
      margin-bottom: 28px;
    }

    .page-title {
      font-size: clamp(62px, 11vw, 150px);

      line-height: .88;

      letter-spacing: -.07em;

      font-weight: 600;
    }

    .page-description {
      max-width: 610px;

      margin-top: 38px;

      font-size: 16px;

      line-height: 1.8;

      color: var(--muted);
    }


    /* =========================================================
       SETS SECTION
    ========================================================= */

    .sets {
      padding: 110px 0 140px;
    }

    .sets-header {
      display: flex;

      justify-content: space-between;
      align-items: flex-end;

      margin-bottom: 55px;
    }

    .section-title {
      font-size: clamp(34px, 5vw, 62px);

      letter-spacing: -.045em;

      line-height: 1;

      font-weight: 500;
    }

    .section-intro {
      max-width: 370px;

      font-size: 13px;

      line-height: 1.8;

      color: var(--muted);
    }


    /* =========================================================
       FEATURED SET
    ========================================================= */

    .featured-set {
      display: grid;

      grid-template-columns: 1fr 1.25fr;

      border: 1px solid var(--border);

      background: var(--surface);

      min-height: 430px;
    }

    .featured-info {
      padding: 50px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      border-right: 1px solid var(--border);
    }

    .set-index {
      font-size: 10px;

      letter-spacing: .18em;

      color: var(--faint);

      text-transform: uppercase;
    }

    .featured-meta {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .set-category {
      font-size: 10px;

      letter-spacing: .18em;

      text-transform: uppercase;

      color: var(--cyan);
    }

    .featured-title {
      font-size: clamp(32px, 4vw, 54px);

      line-height: 1;

      letter-spacing: -.045em;

      font-weight: 500;

      margin-bottom: 18px;
    }

    .featured-description {
      max-width: 430px;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.8;
    }

    .featured-date {
      margin-top: 25px;

      font-size: 10px;

      color: var(--faint);

      letter-spacing: .14em;

      text-transform: uppercase;
    }


    /* =========================================================
       PLAYER
    ========================================================= */

    .featured-player {
      position: relative;

      min-height: 430px;

      display: flex;
      align-items: center;
      justify-content: center;

      overflow: hidden;

      background:
        radial-gradient(
          circle at 50% 100%,
          rgba(123,44,255,.24),
          transparent 62%
        ),

        radial-gradient(
          circle at 20% 30%,
          rgba(0,200,255,.08),
          transparent 40%
        ),

        #08080b;
    }

    .player-glow {
      position: absolute;

      width: 500px;
      height: 500px;

      left: 50%;
      top: 50%;

      transform: translate(-50%, -50%);

      background:
        radial-gradient(
          circle,
          rgba(123,44,255,.10),
          transparent 65%
        );

      pointer-events: none;
    }

    .soundcloud-player {
      position: relative;
      z-index: 2;

      width: calc(100% - 80px);

      max-width: 700px;

      border: 1px solid rgba(255,255,255,.08);

      background: #09090d;

      box-shadow:
        0 20px 70px rgba(0,0,0,.35);
    }

    .soundcloud-player iframe {
      display: block;

      width: 100%;

      min-height: 300px;

      border: 0;
    }

    .player-label {
      position: absolute;

      left: 28px;
      bottom: 22px;

      z-index: 3;

      font-size: 9px;

      letter-spacing: .16em;

      text-transform: uppercase;

      color: var(--faint);

      pointer-events: none;
    }


    /* =========================================================
       SETS GRID
    ========================================================= */

    .archive {
      margin-top: 100px;
    }

    .archive-header {
      display: flex;

      align-items: center;

      justify-content: space-between;

      padding-bottom: 25px;

      border-bottom: 1px solid var(--border);
    }

    .archive-title {
      font-size: 28px;

      letter-spacing: -.035em;

      font-weight: 500;
    }

    .archive-label {
      font-size: 9px;

      letter-spacing: .16em;

      text-transform: uppercase;

      color: var(--muted);
    }

    .sets-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 12px;

      margin-top: 12px;
    }

    .set-card {
      background: var(--surface);

      border: 1px solid var(--border);

      transition:
        transform .25s ease,
        border-color .25s ease,
        background .25s ease;
    }

    .set-card:hover {
      transform: translateY(-4px);

      border-color:
        rgba(123,44,255,.45);

      background: var(--surface-2);
    }

    .set-visual {
      position: relative;

      height: 230px;

      display: flex;

      align-items: flex-end;

      justify-content: center;

      padding-bottom: 30px;

      overflow: hidden;

      background:
        radial-gradient(
          circle at 50% 100%,
          rgba(123,44,255,.22),
          transparent 60%
        ),

        #09090d;
    }

    .bars {
      display: flex;

      align-items: flex-end;

      gap: 3px;

      height: 70px;
    }

    .bars span {
      width: 4px;

      border-radius: 3px 3px 0 0;

      background:
        linear-gradient(
          to top,
          var(--cyan),
          var(--violet)
        );

      opacity: .7;

      animation:
        frequency 1.8s ease-in-out infinite;
    }

    .bars span:nth-child(1)  { height: 18px; animation-delay: .0s; }
    .bars span:nth-child(2)  { height: 35px; animation-delay: .1s; }
    .bars span:nth-child(3)  { height: 48px; animation-delay: .2s; }
    .bars span:nth-child(4)  { height: 27px; animation-delay: .3s; }
    .bars span:nth-child(5)  { height: 62px; animation-delay: .4s; }
    .bars span:nth-child(6)  { height: 40px; animation-delay: .5s; }
    .bars span:nth-child(7)  { height: 55px; animation-delay: .6s; }
    .bars span:nth-child(8)  { height: 30px; animation-delay: .7s; }
    .bars span:nth-child(9)  { height: 45px; animation-delay: .8s; }
    .bars span:nth-child(10) { height: 58px; animation-delay: .9s; }
    .bars span:nth-child(11) { height: 32px; animation-delay: 1s; }
    .bars span:nth-child(12) { height: 50px; animation-delay: 1.1s; }
    .bars span:nth-child(13) { height: 23px; animation-delay: 1.2s; }
    .bars span:nth-child(14) { height: 43px; animation-delay: 1.3s; }
    .bars span:nth-child(15) { height: 35px; animation-delay: 1.4s; }

    @keyframes frequency {
      0%,100% {
        transform: scaleY(.45);
        opacity: .4;
      }

      50% {
        transform: scaleY(1);
        opacity: .9;
      }
    }

    .play-circle {
      position: absolute;

      right: 15px;
      bottom: 15px;

      width: 38px;
      height: 38px;

      display: flex;

      align-items: center;
      justify-content: center;

      border:
        1px solid rgba(255,255,255,.2);

      border-radius: 50%;
    }

    .play-circle::after {
      content: "";

      width: 0;
      height: 0;

      border-top:
        5px solid transparent;

      border-bottom:
        5px solid transparent;

      border-left:
        8px solid var(--white);

      margin-left: 2px;
    }

    .set-info {
      padding: 20px;
    }

    .set-platform {
      font-size: 9px;

      letter-spacing: .15em;

      text-transform: uppercase;

      color: var(--cyan);

      margin-bottom: 9px;
    }

    .set-name {
      font-size: 15px;

      font-weight: 600;

      margin-bottom: 7px;
    }

    .set-meta {
      font-size: 10px;

      color: var(--muted);
    }


    /* =========================================================
       NATURAL CONNECTION
    ========================================================= */

    .connection {
      position: relative;

      overflow: hidden;

      padding: 140px 0;

      margin-top: 40px;

      border-top: 1px solid var(--border);

      border-bottom: 1px solid var(--border);
    }

    .connection-bg {
      position: absolute;

      inset: 0;

      background:
        radial-gradient(
          ellipse at 50% 100%,
          rgba(123,44,255,.22),
          transparent 55%
        ),

        radial-gradient(
          ellipse at 15% 50%,
          rgba(0,200,255,.08),
          transparent 40%
        ),

        radial-gradient(
          ellipse at 85% 30%,
          rgba(232,0,90,.07),
          transparent 40%
        );
    }

    .connection-content {
      position: relative;

      text-align: center;
    }

    .connection-title {
      margin-top: 25px;

      font-size: clamp(50px, 9vw, 120px);

      line-height: .9;

      letter-spacing: -.065em;

      font-weight: 600;
    }

    .connection-description {
      max-width: 580px;

      margin: 38px auto 0;

      color: var(--muted);

      font-size: 15px;

      line-height: 1.8;
    }

    .frequency-main {
      display: flex;

      align-items: center;

      justify-content: center;

      gap: 3px;

      height: 50px;

      margin-top: 55px;
    }

    .frequency-main span {
      width: 3px;

      border-radius: 4px;

      background:
        linear-gradient(
          to top,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );

      animation:
        frequency 1.8s ease-in-out infinite;
    }

    .frequency-main span:nth-child(1)  { height: 15px; animation-delay: .0s; }
    .frequency-main span:nth-child(2)  { height: 30px; animation-delay: .1s; }
    .frequency-main span:nth-child(3)  { height: 42px; animation-delay: .2s; }
    .frequency-main span:nth-child(4)  { height: 24px; animation-delay: .3s; }
    .frequency-main span:nth-child(5)  { height: 50px; animation-delay: .4s; }
    .frequency-main span:nth-child(6)  { height: 32px; animation-delay: .5s; }
    .frequency-main span:nth-child(7)  { height: 44px; animation-delay: .6s; }
    .frequency-main span:nth-child(8)  { height: 20px; animation-delay: .7s; }
    .frequency-main span:nth-child(9)  { height: 38px; animation-delay: .8s; }
    .frequency-main span:nth-child(10) { height: 48px; animation-delay: .9s; }
    .frequency-main span:nth-child(11) { height: 26px; animation-delay: 1s; }
    .frequency-main span:nth-child(12) { height: 40px; animation-delay: 1.1s; }
    .frequency-main span:nth-child(13) { height: 18px; animation-delay: 1.2s; }


    /* =========================================================
       CTA
    ========================================================= */

    .cta {
      padding: 150px 0;

      text-align: center;
    }

    .cta-title {
      font-size: clamp(48px, 8vw, 110px);

      line-height: .95;

      letter-spacing: -.06em;

      font-weight: 500;
    }

    .cta-text {
      max-width: 560px;

      margin: 30px auto 40px;

      font-size: 14px;

      line-height: 1.8;

      color: var(--muted);
    }

    .cta-button {
      display: inline-flex;

      align-items: center;

      justify-content: center;

      padding: 14px 24px;

      background: var(--white);

      color: #050505;

      font-size: 10px;

      font-weight: 600;

      letter-spacing: .15em;

      text-transform: uppercase;

      transition: all .25s ease;
    }

    .cta-button:hover {
      background: var(--cyan);
    }


    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      padding: 30px 40px;

      display: flex;

      justify-content: space-between;

      align-items: center;

      border-top:
        1px solid var(--border);
    }

    .footer-brand {
      font-size: 10px;

      letter-spacing: .14em;

      text-transform: uppercase;

      color: var(--faint);
    }

    .socials {
      display: flex;

      gap: 22px;
    }

    .socials a {
      font-size: 9px;

      letter-spacing: .12em;

      text-transform: uppercase;

      color: var(--muted);

      transition:
        color .2s ease;
    }

    .socials a:hover {
      color: var(--white);
    }


    /* =========================================================
       TABLET
    ========================================================= */

    @media (max-width: 900px) {

      .container {
        width:
          min(
            100% - 40px,
            var(--max)
          );
      }

      nav {
        padding: 20px;
      }

      .nav-links {
        display: none;
      }

      .nav-right {
        gap: 0;
      }

      .page-hero {
        min-height: auto;
      }

      .page-hero-content {
        padding:
          100px 0 90px;
      }

      .page-title {
        font-size:
          clamp(
            58px,
            16vw,
            100px
          );
      }

      .page-description {
        font-size: 14px;
      }

      .sets {
        padding: 80px 0 100px;
      }

      .sets-header {
        display: block;
      }

      .section-intro {
        margin-top: 25px;
      }

      .featured-set {
        grid-template-columns: 1fr;
      }

      .featured-info {
        border-right: 0;

        border-bottom:
          1px solid var(--border);

        min-height: 340px;

        padding: 36px;
      }

      .featured-player {
        min-height: 380px;
      }

      .soundcloud-player {
        width: calc(100% - 50px);
      }

      .sets-grid {
        grid-template-columns:
          repeat(2, 1fr);
      }

      .connection {
        padding: 100px 0;
      }

      .cta {
        padding: 110px 0;
      }

      footer {
        padding: 25px 20px;

        flex-direction: column;

        gap: 20px;
      }
    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 520px) {

      .nav-button {
        padding:
          9px 13px;
      }

      .page-hero-content {
        padding:
          85px 0 75px;
      }

      .page-title {
        font-size:
          clamp(
            54px,
            18vw,
            82px
          );
      }

      .page-description {
        font-size: 13px;
      }

      .featured-info {
        padding: 28px;

        min-height: 310px;
      }

      .featured-player {
        min-height: 350px;
      }

      .soundcloud-player {
        width: calc(100% - 30px);
      }

      .soundcloud-player iframe {
        min-height: 280px;
      }

      .sets-grid {
        grid-template-columns: 1fr;
      }

      .set-visual {
        height: 200px;
      }

      .connection {
        padding: 90px 0;
      }

      .cta {
        padding: 100px 0;
      }

      .socials {
        flex-wrap: wrap;

        justify-content: center;
      }

    }

  </style>
</head>


<body>

  <!-- =======================================================
       TOP GRADIENT LINE
  ======================================================== -->

  <div class="pulse-line"></div>


  <!-- =======================================================
       NAVIGATION
  ======================================================== -->

  <nav>

    <a href="index.html" class="logo">

      <img
        src="logo.png"
        alt="WeAreParty"
      />

    </a>

    <div class="nav-right">

      <ul class="nav-links">

        <li>
          <a href="sets.html" class="active">
            Sets
          </a>
        </li>

        <li>
          <a href="index.html#encuentros">
            Próximos encuentros
          </a>
        </li>

        <li>
          <a href="index.html#comunidad">
            Comunidad
          </a>
        </li>

        <li>
          <a href="filosofia.html">
            Filosofía
          </a>
        </li>

      </ul>

      <a href="contacto.html" class="nav-button">
        Entrar
      </a>

    </div>

  </nav>


  <!-- =======================================================
       HERO
  ======================================================== -->

  <header class="page-hero">

    <div class="page-hero-background">

      <div class="glow-1"></div>
      <div class="glow-2"></div>
      <div class="page-grid"></div>

    </div>

    <div class="container">

      <div class="page-hero-content">

        <div class="eyebrow page-hero-eyebrow">
          WEAREPARTY / AUDIO
        </div>

        <h1 class="page-title">
          LOS
          <span class="gradient-text">
            SETS.
          </span>
        </h1>

        <p class="page-description">
          Sesiones, sonidos y momentos compartidos.
          Una selección de música electrónica que forma parte
          del universo WeAreParty.
        </p>

      </div>

    </div>

  </header>


  <!-- =======================================================
       FEATURED SET
  ======================================================== -->

  <main>

    <section class="sets">

      <div class="container">

        <div class="sets-header">

          <div>

            <div class="eyebrow">
              WEAREPARTY SESSIONS
            </div>

            <h2 class="section-title">
              Escucha
              <span class="gradient-text">
                dentro.
              </span>
            </h2>

          </div>

          <p class="section-intro">
            La música es el punto de encuentro.
            Dale al play y continúa navegando por
            WeAreParty mientras escuchas la sesión.
          </p>

        </div>


        <!-- ===================================================
             FEATURED SET
        ==================================================== -->

        <article class="featured-set">

          <div class="featured-info">

