<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Sets — WeAreParty</title>

  <meta
    name="description"
    content="Escucha los sets de WeAreParty. Música electrónica, sesiones y Natural Connection."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>

    /* =========================================================
       WEAREPARTY
       SETS
    ========================================================= */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #060606;
      --surface: #0b0b0c;
      --surface-2: #101011;

      --white: #ffffff;
      --text: rgba(255,255,255,.88);
      --muted: rgba(255,255,255,.45);
      --faint: rgba(255,255,255,.20);

      --cyan: #00c8ff;
      --violet: #7b2cff;
      --magenta: #e8005a;

      --border: rgba(255,255,255,.08);

      --max: 1440px;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--white);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(var(--max), calc(100% - 80px));
      margin: 0 auto;
    }

    .eyebrow {
      font-size: 10px;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .gradient-text {
      background: linear-gradient(
        90deg,
        var(--cyan),
        var(--violet),
        var(--magenta)
      );

      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* =========================================================
       TOP LINE
    ========================================================= */

    .pulse-line {
      position: fixed;
      top: 0;
      left: 0;

      width: 100%;
      height: 2px;

      z-index: 1000;

      background:
        linear-gradient(
          90deg,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );
    }

    /* =========================================================
       NAVIGATION
    ========================================================= */

    nav {
      position: relative;
      z-index: 20;

      width: 100%;
      padding: 26px 40px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      border-bottom: 1px solid var(--border);

      background: rgba(6,6,6,.72);
      backdrop-filter: blur(14px);
    }

    .logo img {
      height: 38px;
      width: auto;
      display: block;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 34px;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;

      color: var(--muted);

      transition: color .25s ease;
    }

    .nav-links a:hover,
    .nav-links a.active {
      color: var(--white);
    }

    .nav-button {
      padding: 10px 18px;

      border: 1px solid rgba(0,200,255,.45);

      color: var(--cyan);

      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;

      transition: all .25s ease;
    }

    .nav-button:hover {
      background: rgba(0,200,255,.08);
      border-color: var(--cyan);
    }

    /* =========================================================
       PAGE HEADER
    ========================================================= */

    .page-header {
      position: relative;
      overflow: hidden;

      padding: 120px 0 90px;

      border-bottom: 1px solid var(--border);
    }

    .page-header-background {
      position: absolute;
      inset: 0;

      pointer-events: none;

      background:
        radial-gradient(
          circle at 80% 20%,
          rgba(123,44,255,.16),
          transparent 38%
        ),

        radial-gradient(
          circle at 15% 80%,
          rgba(0,200,255,.08),
          transparent 35%
        );
    }

    .page-header-grid {
      position: absolute;
      inset: 0;

      background-image:
        linear-gradient(
          rgba(255,255,255,.018) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(255,255,255,.018) 1px,
          transparent 1px
        );

      background-size: 80px 80px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 90%
        );
    }

    .page-header-content {
      position: relative;
      z-index: 2;
    }

    .page-title {
      margin-top: 25px;

      font-size: clamp(64px, 10vw, 150px);

      line-height: .88;

      letter-spacing: -.07em;

      font-weight: 600;
    }

    .page-description {
      max-width: 620px;

      margin-top: 35px;

      font-size: 15px;

      line-height: 1.8;

      color: var(--muted);
    }

    /* =========================================================
       SETS
    ========================================================= */

    .sets {
      padding: 100px 0 140px;
    }

    .sets-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;

      margin-bottom: 45px;
    }

    .sets-heading {
      font-size: 32px;

      letter-spacing: -.035em;

      font-weight: 500;
    }

    .sets-count {
      font-size: 10px;

      color: var(--faint);

      letter-spacing: .16em;

      text-transform: uppercase;
    }

    /* =========================================================
       FEATURED SET
    ========================================================= */

    .featured-set {
      position: relative;

      border: 1px solid var(--border);

      background: var(--surface);

      overflow: hidden;
    }

    .featured-set::before {
      content: "";

      position: absolute;

      width: 500px;
      height: 500px;

      right: -180px;
      bottom: -250px;

      background:
        radial-gradient(
          circle,
          rgba(123,44,255,.20),
          transparent 70%
        );

      pointer-events: none;
    }

    .set-top-line {
      padding: 20px 24px;

      display: flex;
      justify-content: space-between;
      align-items: center;

      border-bottom: 1px solid var(--border);
    }

    .set-category {
      font-size: 9px;

      letter-spacing: .18em;

      text-transform: uppercase;

      color: var(--cyan);
    }

    .set-index {
      font-size: 9px;

      letter-spacing: .15em;

      color: var(--faint);
    }

    .player-wrapper {
      position: relative;

      padding: 34px;

      background:
        radial-gradient(
          ellipse at 50% 100%,
          rgba(123,44,255,.12),
          transparent 60%
        );
    }

    .player-frame {
      width: 100%;

      border: 1px solid rgba(255,255,255,.06);

      background: #080808;

      overflow: hidden;
    }

    .player-frame iframe {
      display: block;

      width: 100%;

      height: 166px;

      border: 0;
    }

    .set-details {
      padding: 0 34px 34px;

      display: grid;

      grid-template-columns: 1fr auto;

      gap: 30px;

      align-items: end;
    }

    .set-title {
      font-size: clamp(28px, 4vw, 48px);

      letter-spacing: -.045em;

      line-height: 1;
    }

    .set-meta {
      margin-top: 14px;

      font-size: 11px;

      color: var(--muted);

      letter-spacing: .04em;
    }

    .soundcloud-link {
      display: inline-flex;

      align-items: center;
      justify-content: center;

      padding: 13px 18px;

      border: 1px solid var(--border);

      font-size: 9px;

      letter-spacing: .14em;

      text-transform: uppercase;

      color: var(--muted);

      transition:
        border-color .25s ease,
        color .25s ease,
        background .25s ease;
    }

    .soundcloud-link:hover {
      border-color: rgba(0,200,255,.5);

      color: var(--cyan);

      background: rgba(0,200,255,.04);
    }

    /* =========================================================
       FUTURE SETS
    ========================================================= */

    .future-section {
      margin-top: 100px;
    }

    .future-header {
      display: flex;

      justify-content: space-between;

      align-items: center;

      padding-bottom: 20px;

      border-bottom: 1px solid var(--border);
    }

    .future-title {
      font-size: 24px;

      letter-spacing: -.03em;

      font-weight: 500;
    }

    .future-label {
      font-size: 9px;

      color: var(--faint);

      letter-spacing: .15em;

      text-transform: uppercase;
    }

    .future-card {
      min-height: 180px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      padding: 35px 0;

      border-bottom: 1px solid var(--border);
    }

    .future-number {
      font-size: 10px;

      color: var(--faint);

      letter-spacing: .15em;
    }

    .future-main {
      flex: 1;

      margin-left: 50px;
    }

    .future-main h3 {
      font-size: 22px;

      font-weight: 500;

      margin-bottom: 8px;
    }

    .future-main p {
      font-size: 12px;

      color: var(--muted);
    }

    .future-status {
      font-size: 9px;

      letter-spacing: .14em;

      text-transform: uppercase;

      color: var(--cyan);
    }

    /* =========================================================
       CTA
    ========================================================= */

    .cta {
      position: relative;

      overflow: hidden;

      padding: 140px 0;

      text-align: center;

      border-top: 1px solid var(--border);
    }

    .cta-background {
      position: absolute;
      inset: 0;

      background:
        radial-gradient(
          ellipse at 50% 100%,
          rgba(123,44,255,.18),
          transparent 60%
        );
    }

    .cta-content {
      position: relative;
      z-index: 2;
    }

    .cta-title {
      font-size: clamp(48px, 8vw, 110px);

      line-height: .92;

      letter-spacing: -.06em;

      font-weight: 500;
    }

    .cta-text {
      max-width: 560px;

      margin: 30px auto 40px;

      font-size: 14px;

      line-height: 1.8;

      color: var(--muted);
    }

    .cta-button {
      display: inline-flex;

      padding: 14px 24px;

      background: var(--white);

      color: #050505;

      font-size: 10px;

      font-weight: 600;

      letter-spacing: .15em;

      text-transform: uppercase;

      transition:
        background .25s ease;
    }

    .cta-button:hover {
      background: var(--cyan);
    }

    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      padding: 30px 40px;

      display: flex;

      justify-content: space-between;

      align-items: center;

      border-top: 1px solid var(--border);
    }

    .footer-brand {
      font-size: 10px;

      letter-spacing: .14em;

      text-transform: uppercase;

      color: var(--faint);
    }

    .socials {
      display: flex;

      gap: 22px;
    }

    .socials a {
      font-size: 9px;

      letter-spacing: .12em;

      text-transform: uppercase;

      color: var(--muted);

      transition: color .2s ease;
    }

    .socials a:hover {
      color: var(--white);
    }

    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 900px) {

      .container {
        width: min(100% - 40px, var(--max));
      }

      nav {
        padding: 20px;
      }

      .nav-links {
        display: none;
      }

      .nav-right {
        gap: 0;
      }

      .page-header {
        padding: 100px 0 70px;
      }

      .page-title {
        font-size: clamp(58px, 17vw, 100px);
      }

      .sets {
        padding: 80px 0 100px;
      }

      .player-wrapper {
        padding: 18px;
      }

      .set-details {
        grid-template-columns: 1fr;

        padding: 0 18px 24px;
      }

      .soundcloud-link {
        width: 100%;
      }

      .future-section {
        margin-top: 70px;
      }

      .future-card {
        min-height: 150px;
      }

      .future-main {
        margin-left: 25px;
      }

      .cta {
        padding: 100px 0;
      }

      footer {
        padding: 25px 20px;

        flex-direction: column;

        gap: 20px;
      }
    }

    @media (max-width: 520px) {

      .nav-button {
        padding: 9px 13px;
      }

      .page-description {
        font-size: 14px;
      }

      .sets-top {
        display: block;
      }

      .sets-count {
        display: block;

        margin-top: 12px;
      }

      .set-top-line {
        padding: 17px;
      }

      .player-wrapper {
        padding: 10px;
      }

      .player-frame iframe {
        height: 166px;
      }

      .set-title {
        font-size: 30px;
      }

      .future-card {
        display: grid;

        grid-template-columns: 35px 1fr;

        gap: 10px;

        padding: 28px 0;
      }

      .future-status {
        grid-column: 2;
        margin-top: 8px;
      }

      .future-main {
        margin-left: 0;
      }

      .socials {
        flex-wrap: wrap;

        justify-content: center;
      }
    }

  </style>
</head>


