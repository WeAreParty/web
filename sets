  <style>

    /* =========================================================
       WEAREPARTY
       SETS
    ========================================================= */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #060606;
      --surface: #0b0b0c;
      --surface-2: #101011;

      --white: #ffffff;
      --text: rgba(255,255,255,.88);
      --muted: rgba(255,255,255,.45);
      --faint: rgba(255,255,255,.20);

      --cyan: #00c8ff;
      --violet: #7b2cff;
      --magenta: #e8005a;

      --border: rgba(255,255,255,.08);

      --max: 1440px;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--white);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(var(--max), calc(100% - 80px));
      margin: 0 auto;
    }

    .eyebrow {
      font-size: 10px;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .gradient-text {
      background: linear-gradient(
        90deg,
        var(--cyan),
        var(--violet),
        var(--magenta)
      );

      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* =========================================================
       TOP LINE
    ========================================================= */

    .pulse-line {
      position: fixed;
      top: 0;
      left: 0;

      width: 100%;
      height: 2px;

      z-index: 1000;

      background:
        linear-gradient(
          90deg,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );
    }

    /* =========================================================
       NAVIGATION
    ========================================================= */

    nav {
      position: relative;
      z-index: 20;

      width: 100%;
      padding: 26px 40px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      border-bottom: 1px solid var(--border);

      background: rgba(6,6,6,.72);
      backdrop-filter: blur(14px);
    }

    .logo img {
      height: 38px;
      width: auto;
      display: block;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 34px;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;

      color: var(--muted);

      transition: color .25s ease;
    }

    .nav-links a:hover {
      color: var(--white);
    }

    .nav-links a.active {
      color: var(--white);
    }

    .nav-button {
      padding: 10px 18px;

      border: 1px solid rgba(0,200,255,.45);

      color: var(--cyan);

      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;

      transition: all .25s ease;
    }

    .nav-button:hover {
      background: rgba(0,200,255,.08);
      border-color: var(--cyan);
    }

    /* =========================================================
       HERO
    ========================================================= */

    .sets-hero {
      position: relative;
      overflow: hidden;

      padding: 120px 0 90px;

      border-bottom: 1px solid var(--border);
    }

    .hero-glow {
      position: absolute;
      width: 800px;
      height: 500px;

      right: -180px;
      top: -120px;

      background:
        radial-gradient(
          ellipse,
          rgba(123,44,255,.18),
          transparent 68%
        );

      filter: blur(30px);

      pointer-events: none;
    }

    .hero-glow-left {
      position: absolute;
      width: 600px;
      height: 500px;

      left: -300px;
      bottom: -250px;

      background:
        radial-gradient(
          ellipse,
          rgba(0,200,255,.09),
          transparent 68%
        );

      filter: blur(30px);

      pointer-events: none;
    }

    .sets-hero-content {
      position: relative;
      z-index: 2;
    }

    .sets-hero h1 {
      margin-top: 25px;

      font-size: clamp(60px, 10vw, 140px);

      line-height: .88;

      letter-spacing: -.07em;

      font-weight: 600;
    }

    .sets-hero h1 span {
      display: block;
    }

    .sets-hero-description {
      max-width: 620px;

      margin-top: 42px;

      color: var(--muted);

      font-size: 15px;
      line-height: 1.8;
    }

    /* =========================================================
       FEATURED SET
    ========================================================= */

    .featured {
      padding: 100px 0 120px;
    }

    .featured-label {
      margin-bottom: 30px;
    }

    .featured-grid {
      display: grid;

      grid-template-columns: 1fr 1.4fr;

      gap: 70px;

      align-items: center;
    }

    /* =========================================================
       VISUAL
    ========================================================= */

    .set-art {
      position: relative;

      min-height: 460px;

      overflow: hidden;

      border: 1px solid var(--border);

      background:
        radial-gradient(
          circle at 50% 100%,
          rgba(123,44,255,.28),
          transparent 55%
        ),
        radial-gradient(
          circle at 20% 20%,
          rgba(0,200,255,.10),
          transparent 40%
        ),
        radial-gradient(
          circle at 80% 30%,
          rgba(232,0,90,.08),
          transparent 40%
        ),
        #09090d;
    }

    .set-art::before {
      content: "";

      position: absolute;
      inset: 0;

      background-image:
        linear-gradient(
          rgba(255,255,255,.018) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(255,255,255,.018) 1px,
          transparent 1px
        );

      background-size: 55px 55px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent
        );
    }

    .art-number {
      position: absolute;

      top: 30px;
      left: 30px;

      font-size: 10px;

      color: var(--faint);

      letter-spacing: .18em;
    }

    .art-title {
      position: absolute;

      left: 30px;
      bottom: 30px;

      font-size: clamp(42px, 5vw, 72px);

      line-height: .9;

      letter-spacing: -.065em;

      font-weight: 600;
    }

    .waveform {
      position: absolute;

      left: 30px;
      right: 30px;

      top: 50%;

      height: 90px;

      transform: translateY(-50%);

      display: flex;
      align-items: center;
      justify-content: center;

      gap: 4px;
    }

    .waveform span {
      width: 3px;

      border-radius: 3px;

      background:
        linear-gradient(
          to top,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );

      opacity: .75;

      animation: wave 1.7s ease-in-out infinite;
    }

    .waveform span:nth-child(1)  { height: 18px; animation-delay: 0s; }
    .waveform span:nth-child(2)  { height: 34px; animation-delay: .08s; }
    .waveform span:nth-child(3)  { height: 52px; animation-delay: .16s; }
    .waveform span:nth-child(4)  { height: 27px; animation-delay: .24s; }
    .waveform span:nth-child(5)  { height: 68px; animation-delay: .32s; }
    .waveform span:nth-child(6)  { height: 42px; animation-delay: .40s; }
    .waveform span:nth-child(7)  { height: 76px; animation-delay: .48s; }
    .waveform span:nth-child(8)  { height: 48px; animation-delay: .56s; }
    .waveform span:nth-child(9)  { height: 64px; animation-delay: .64s; }
    .waveform span:nth-child(10) { height: 34px; animation-delay: .72s; }
    .waveform span:nth-child(11) { height: 72px; animation-delay: .80s; }
    .waveform span:nth-child(12) { height: 44px; animation-delay: .88s; }
    .waveform span:nth-child(13) { height: 58px; animation-delay: .96s; }
    .waveform span:nth-child(14) { height: 30px; animation-delay: 1.04s; }
    .waveform span:nth-child(15) { height: 68px; animation-delay: 1.12s; }
    .waveform span:nth-child(16) { height: 40px; animation-delay: 1.20s; }
    .waveform span:nth-child(17) { height: 54px; animation-delay: 1.28s; }
    .waveform span:nth-child(18) { height: 28px; animation-delay: 1.36s; }

    @keyframes wave {
      0%,100% {
        transform: scaleY(.45);
        opacity: .35;
      }

      50% {
        transform: scaleY(1);
        opacity: .9;
      }
    }

    /* =========================================================
       SET INFORMATION
    ========================================================= */

    .set-content {
      max-width: 650px;
    }

    .set-type {
      font-size: 10px;

      letter-spacing: .20em;

      text-transform: uppercase;

      color: var(--cyan);

      margin-bottom: 18px;
    }

    .set-content h2 {
      font-size: clamp(38px, 5vw, 68px);

      line-height: .95;

      letter-spacing: -.055em;

      font-weight: 500;
    }

    .set-content h2 span {
      display: block;
    }

    .set-description {
      margin-top: 30px;

      max-width: 520px;

      color: var(--muted);

      font-size: 14px;

      line-height: 1.9;
    }

    .set-meta {
      display: flex;

      gap: 35px;

      margin-top: 35px;

      padding-top: 25px;

      border-top: 1px solid var(--border);
    }

    .meta-item {
      display: flex;
      flex-direction: column;

      gap: 7px;
    }

    .meta-label {
      font-size: 9px;

      text-transform: uppercase;

      letter-spacing: .16em;

      color: var(--faint);
    }

    .meta-value {
      font-size: 12px;

      color: var(--text);
    }

    /* =========================================================
       SOUNDCLOUD
    ========================================================= */

    .player-wrapper {
      margin-top: 45px;

      border: 1px solid var(--border);

      background: var(--surface);

      padding: 1px;
    }

    .player-wrapper iframe {
      display: block;

      width: 100%;

      min-height: 166px;

      border: 0;
    }

    .soundcloud-link {
      display: inline-flex;
      align-items: center;

      margin-top: 20px;

      font-size: 10px;

      letter-spacing: .15em;

      text-transform: uppercase;

      color: var(--cyan);

      transition: color .25s ease;
    }

    .soundcloud-link:hover {
      color: var(--white);
    }

    .soundcloud-link::after {
      content: "↗";

      margin-left: 8px;

      font-size: 14px;
    }

    /* =========================================================
       PHILOSOPHY STRIP
    ========================================================= */

    .connection-strip {
      position: relative;

      overflow: hidden;

      padding: 110px 0;

      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);

      text-align: center;
    }

    .connection-strip-bg {
      position: absolute;
      inset: 0;

      background:
        radial-gradient(
          ellipse at 50% 100%,
          rgba(123,44,255,.18),
          transparent 55%
        ),
        radial-gradient(
          ellipse at 15% 50%,
          rgba(0,200,255,.07),
          transparent 40%
        ),
        radial-gradient(
          ellipse at 85% 40%,
          rgba(232,0,90,.06),
          transparent 40%
        );
    }

    .connection-strip-content {
      position: relative;
      z-index: 2;
    }

    .connection-strip h2 {
      margin-top: 25px;

      font-size: clamp(48px, 8vw, 110px);

      line-height: .9;

      letter-spacing: -.065em;

      font-weight: 600;
    }

    .connection-strip p {
      max-width: 560px;

      margin: 30px auto 0;

      color: var(--muted);

      font-size: 14px;

      line-height: 1.8;
    }

    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      padding: 30px 40px;

      display: flex;

      justify-content: space-between;
      align-items: center;

      border-top: 1px solid var(--border);
    }

    .footer-brand {
      font-size: 10px;

      letter-spacing: .14em;

      text-transform: uppercase;

      color: var(--faint);
    }

    .socials {
      display: flex;

      gap: 22px;
    }

    .socials a {
      font-size: 9px;

      letter-spacing: .12em;

      text-transform: uppercase;

      color: var(--muted);

      transition: color .2s ease;
    }

    .socials a:hover {
      color: var(--white);
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 900px) {

      .container {
        width: min(
          calc(100% - 40px),
          var(--max)
        );
      }

      nav {
        padding: 20px;
      }

      .nav-links {
        display: none;
      }

      .nav-right {
        gap: 0;
      }

      .sets-hero {
        padding: 90px 0 70px;
      }

      .sets-hero h1 {
        font-size: clamp(
          58px,
          16vw,
          90px
        );
      }

      .featured {
        padding: 80px 0 90px;
      }

      .featured-grid {
        grid-template-columns: 1fr;

        gap: 50px;
      }

      .set-art {
        min-height: 380px;
      }

      .connection-strip {
        padding: 90px 0;
      }

      footer {
        padding: 25px 20px;

        flex-direction: column;

        gap: 20px;
      }
    }

    @media (max-width: 520px) {

      .logo img {
        height: 32px;
      }

      .nav-button {
        padding: 9px 13px;
      }

      .sets-hero {
        padding: 80px 0 60px;
      }

      .sets-hero-description {
        font-size: 14px;
      }

      .set-art {
        min-height: 330px;
      }

      .art-title {
        font-size: 42px;
      }

      .set-content h2 {
        font-size: 42px;
      }

      .set-meta {
        flex-wrap: wrap;

        gap: 22px;
      }

      .player-wrapper iframe {
        min-height: 166px;
      }

      .socials {
        flex-wrap: wrap;

        justify-content: center;
      }
    }

  </style>
</head>

