<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Sets — WeAreParty | Natural Connection</title>

  <meta
    name="description"
    content="Sets de WeAreParty. Música electrónica, sesiones y conexiones sonoras."
  />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />

  <style>

    /* =========================================================
       WEAREPARTY
       SETS
       Natural Connection
    ========================================================= */

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #060606;
      --surface: #0b0b0c;
      --surface-2: #101011;

      --white: #ffffff;
      --text: rgba(255,255,255,.88);
      --muted: rgba(255,255,255,.45);
      --faint: rgba(255,255,255,.20);

      --cyan: #00c8ff;
      --violet: #7b2cff;
      --magenta: #e8005a;

      --border: rgba(255,255,255,.08);

      --max: 1440px;
    }


    /* =========================================================
       BASE
    ========================================================= */

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--white);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(var(--max), calc(100% - 80px));
      margin: 0 auto;
    }

    .eyebrow {
      font-size: 10px;
      letter-spacing: .24em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .gradient-text {
      background:
        linear-gradient(
          90deg,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );

      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .pulse-line {
      position: fixed;
      top: 0;
      left: 0;

      width: 100%;
      height: 2px;

      z-index: 1000;

      background:
        linear-gradient(
          90deg,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );
    }


    /* =========================================================
       NAVIGATION
    ========================================================= */

    nav {
      position: relative;
      z-index: 20;

      width: 100%;
      padding: 26px 40px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      border-bottom: 1px solid var(--border);

      background: rgba(6,6,6,.72);
      backdrop-filter: blur(14px);
    }

    .logo img {
      height: 38px;
      width: auto;
      display: block;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 34px;
    }

    .nav-links {
      display: flex;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;

      color: var(--muted);

      transition: color .25s ease;
    }

    .nav-links a:hover {
      color: var(--white);
    }

    .nav-links a.active {
      color: var(--white);
    }

    .nav-button {
      padding: 10px 18px;

      border: 1px solid rgba(0,200,255,.45);

      color: var(--cyan);

      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;

      transition: all .25s ease;
    }

    .nav-button:hover {
      background: rgba(0,200,255,.08);
      border-color: var(--cyan);
    }


    /* =========================================================
       PAGE HERO
    ========================================================= */

    .page-hero {
      position: relative;

      min-height: 56vh;

      display: flex;
      align-items: flex-end;

      overflow: hidden;

      border-bottom: 1px solid var(--border);
    }

    .page-hero-background {
      position: absolute;
      inset: 0;

      pointer-events: none;
    }

    .glow-1 {
      position: absolute;

      width: 700px;
      height: 700px;

      right: -200px;
      top: -180px;

      background:
        radial-gradient(
          circle,
          rgba(123,44,255,.20),
          transparent 68%
        );

      filter: blur(20px);
    }

    .glow-2 {
      position: absolute;

      width: 600px;
      height: 600px;

      left: -300px;
      bottom: -350px;

      background:
        radial-gradient(
          circle,
          rgba(0,200,255,.11),
          transparent 68%
        );

      filter: blur(20px);
    }

    .hero-grid {
      position: absolute;
      inset: 0;

      background-image:
        linear-gradient(
          rgba(255,255,255,.018) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(255,255,255,.018) 1px,
          transparent 1px
        );

      background-size: 80px 80px;

      mask-image:
        linear-gradient(
          to bottom,
          black,
          transparent 90%
        );
    }

    .page-hero-content {
      position: relative;
      z-index: 2;

      width: 100%;

      padding: 100px 0 80px;
    }

    .page-hero-content .eyebrow {
      margin-bottom: 28px;
    }

    .page-title {
      font-size: clamp(70px, 12vw, 170px);

      line-height: .84;
      letter-spacing: -.075em;

      font-weight: 600;
    }

    .page-intro {
      max-width: 600px;

      margin-top: 42px;

      font-size: 15px;
      line-height: 1.8;

      color: var(--muted);
    }


    /* =========================================================
       SETS SECTION
    ========================================================= */

    .sets {
      padding: 110px 0 140px;
    }

    .sets-header {
      display: flex;

      justify-content: space-between;
      align-items: flex-end;

      margin-bottom: 50px;
    }

    .sets-heading {
      font-size: clamp(34px, 5vw, 62px);

      line-height: 1;

      letter-spacing: -.045em;

      font-weight: 500;
    }

    .sets-header-description {
      max-width: 340px;

      font-size: 13px;

      line-height: 1.8;

      color: var(--muted);
    }


    /* =========================================================
       FEATURED SET
    ========================================================= */

    .featured-set {
      border: 1px solid var(--border);

      background: var(--surface);

      overflow: hidden;
    }

    .featured-top {
      display: grid;

      grid-template-columns: 1fr 1fr;

      min-height: 430px;
    }

    .featured-visual {
      position: relative;

      display: flex;

      align-items: center;
      justify-content: center;

      overflow: hidden;

      background:
        radial-gradient(
          circle at 50% 65%,
          rgba(123,44,255,.27),
          transparent 48%
        ),

        radial-gradient(
          circle at 20% 20%,
          rgba(0,200,255,.09),
          transparent 35%
        ),

        radial-gradient(
          circle at 85% 25%,
          rgba(232,0,90,.08),
          transparent 35%
        ),

        #08080b;
    }

    .visual-ring {
      position: absolute;

      width: 320px;
      height: 320px;

      border: 1px solid rgba(255,255,255,.08);

      border-radius: 50%;
    }

    .visual-ring::before {
      content: "";

      position: absolute;

      inset: 28px;

      border: 1px solid rgba(123,44,255,.18);

      border-radius: 50%;
    }

    .visual-ring::after {
      content: "";

      position: absolute;

      inset: 75px;

      border: 1px solid rgba(0,200,255,.20);

      border-radius: 50%;
    }

    .visual-center {
      position: relative;

      width: 105px;
      height: 105px;

      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(255,255,255,.18),
          rgba(123,44,255,.30) 30%,
          rgba(6,6,6,.95) 70%
        );

      border: 1px solid rgba(255,255,255,.18);

      box-shadow:
        0 0 80px rgba(123,44,255,.35);
    }

    .visual-center::after {
      content: "";

      position: absolute;

      width: 9px;
      height: 9px;

      left: 50%;
      top: 50%;

      transform: translate(-50%, -50%);

      border-radius: 50%;

      background: var(--white);

      box-shadow:
        0 0 20px rgba(255,255,255,.8);
    }

    .visual-bars {
      position: absolute;

      bottom: 38px;

      display: flex;

      align-items: flex-end;

      gap: 4px;

      height: 70px;
    }

    .visual-bars span {
      width: 4px;

      border-radius: 3px 3px 0 0;

      background:
        linear-gradient(
          to top,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );

      opacity: .75;

      animation:
        soundwave 1.7s ease-in-out infinite;
    }

    .visual-bars span:nth-child(1) {
      height: 20px;
      animation-delay: .0s;
    }

    .visual-bars span:nth-child(2) {
      height: 35px;
      animation-delay: .1s;
    }

    .visual-bars span:nth-child(3) {
      height: 52px;
      animation-delay: .2s;
    }

    .visual-bars span:nth-child(4) {
      height: 30px;
      animation-delay: .3s;
    }

    .visual-bars span:nth-child(5) {
      height: 65px;
      animation-delay: .4s;
    }

    .visual-bars span:nth-child(6) {
      height: 40px;
      animation-delay: .5s;
    }

    .visual-bars span:nth-child(7) {
      height: 55px;
      animation-delay: .6s;
    }

    .visual-bars span:nth-child(8) {
      height: 28px;
      animation-delay: .7s;
    }

    .visual-bars span:nth-child(9) {
      height: 47px;
      animation-delay: .8s;
    }

    .visual-bars span:nth-child(10) {
      height: 60px;
      animation-delay: .9s;
    }

    .visual-bars span:nth-child(11) {
      height: 33px;
      animation-delay: 1s;
    }

    .visual-bars span:nth-child(12) {
      height: 50px;
      animation-delay: 1.1s;
    }

    .visual-bars span:nth-child(13) {
      height: 23px;
      animation-delay: 1.2s;
    }

    @keyframes soundwave {
      0%,100% {
        transform: scaleY(.45);
        opacity: .35;
      }

      50% {
        transform: scaleY(1);
        opacity: .9;
      }
    }


    /* =========================================================
       FEATURED INFORMATION
    ========================================================= */

    .featured-info {
      padding: 48px;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      border-left: 1px solid var(--border);
    }

    .set-category {
      font-size: 9px;

      letter-spacing: .18em;

      text-transform: uppercase;

      color: var(--cyan);

      margin-bottom: 18px;
    }

    .featured-title {
      font-size: clamp(32px, 4vw, 56px);

      line-height: 1;

      letter-spacing: -.05em;

      font-weight: 500;
    }

    .featured-description {
      max-width: 470px;

      margin-top: 25px;

      color: var(--muted);

      font-size: 13px;

      line-height: 1.8;
    }

    .featured-meta {
      display: flex;

      gap: 35px;

      margin-top: 38px;

      padding-top: 25px;

      border-top: 1px solid var(--border);
    }

    .meta-item {
      display: flex;

      flex-direction: column;

      gap: 7px;
    }

    .meta-label {
      font-size: 8px;

      letter-spacing: .16em;

      text-transform: uppercase;

      color: var(--faint);
    }

    .meta-value {
      font-size: 11px;

      color: var(--text);
    }


    /* =========================================================
       SOUNDCLOUD PLAYER
    ========================================================= */

    .player-wrapper {
      padding: 0;

      background: #08080a;

      border-top: 1px solid var(--border);
    }

    .player-label {
      display: flex;

      align-items: center;
      justify-content: space-between;

      padding: 18px 24px;

      border-bottom: 1px solid var(--border);
    }

    .player-label-left {
      display: flex;

      align-items: center;

      gap: 10px;
    }

    .player-dot {
      width: 6px;
      height: 6px;

      border-radius: 50%;

      background: var(--cyan);

      box-shadow:
        0 0 12px rgba(0,200,255,.7);
    }

    .player-label-text {
      font-size: 9px;

      letter-spacing: .16em;

      text-transform: uppercase;

      color: var(--muted);
    }

    .player-platform {
      font-size: 9px;

      letter-spacing: .12em;

      text-transform: uppercase;

      color: var(--faint);
    }

    .soundcloud-frame {
      display: block;

      width: 100%;

      height: 166px;

      border: 0;
    }


    /* =========================================================
       MORE SETS
    ========================================================= */

    .more-sets {
      margin-top: 100px;
    }

    .more-header {
      display: flex;

      justify-content: space-between;
      align-items: center;

      margin-bottom: 35px;
    }

    .more-title {
      font-size: 28px;

      letter-spacing: -.035em;

      font-weight: 500;
    }

    .more-note {
      font-size: 10px;

      letter-spacing: .12em;

      text-transform: uppercase;

      color: var(--faint);
    }

    .set-grid {
      display: grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap: 12px;
    }

    .set-card {
      min-height: 270px;

      padding: 30px;

      display: flex;

      flex-direction: column;

      justify-content: space-between;

      background: var(--surface);

      border: 1px solid var(--border);

      transition:
        transform .25s ease,
        border-color .25s ease,
        background .25s ease;
    }

    .set-card:hover {
      transform: translateY(-4px);

      background: var(--surface-2);

      border-color:
        rgba(123,44,255,.4);
    }

    .card-number {
      font-size: 10px;

      letter-spacing: .15em;

      color: var(--faint);
    }

    .card-bottom {
      display: flex;

      justify-content: space-between;

      align-items: flex-end;
    }

    .card-info h3 {
      font-size: 20px;

      font-weight: 500;

      letter-spacing: -.025em;

      margin-bottom: 8px;
    }

    .card-info p {
      font-size: 10px;

      color: var(--muted);
    }

    .card-arrow {
      width: 34px;
      height: 34px;

      display: flex;

      align-items: center;
      justify-content: center;

      border: 1px solid var(--border);

      border-radius: 50%;

      color: var(--cyan);

      font-size: 16px;
    }


    /* =========================================================
       NATURAL CONNECTION
    ========================================================= */

    .connection {
      position: relative;

      overflow: hidden;

      margin-top: 120px;

      padding: 130px 0;

      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .connection-bg {
      position: absolute;
      inset: 0;

      background:

        radial-gradient(
          ellipse at 50% 100%,
          rgba(123,44,255,.20),
          transparent 55%
        ),

        radial-gradient(
          ellipse at 15% 50%,
          rgba(0,200,255,.07),
          transparent 40%
        ),

        radial-gradient(
          ellipse at 85% 30%,
          rgba(232,0,90,.06),
          transparent 40%
        );
    }

    .connection-content {
      position: relative;

      text-align: center;
    }

    .connection-title {
      margin-top: 25px;

      font-size: clamp(50px, 9vw, 120px);

      line-height: .9;

      letter-spacing: -.065em;

      font-weight: 600;
    }

    .connection-description {
      max-width: 580px;

      margin: 38px auto 0;

      color: var(--muted);

      font-size: 15px;

      line-height: 1.8;
    }

    .frequency {
      display: flex;

      align-items: center;
      justify-content: center;

      gap: 3px;

      height: 50px;

      margin-top: 55px;
    }

    .frequency span {
      width: 3px;

      border-radius: 4px;

      background:
        linear-gradient(
          to top,
          var(--cyan),
          var(--violet),
          var(--magenta)
        );

      animation:
        frequency 1.8s ease-in-out infinite;
    }

    .frequency span:nth-child(1)  { height: 15px; animation-delay: .0s; }
    .frequency span:nth-child(2)  { height: 30px; animation-delay: .1s; }
    .frequency span:nth-child(3)  { height: 42px; animation-delay: .2s; }
    .frequency span:nth-child(4)  { height: 24px; animation-delay: .3s; }
    .frequency span:nth-child(5)  { height: 50px; animation-delay: .4s; }
    .frequency span:nth-child(6)  { height: 32px; animation-delay: .5s; }
    .frequency span:nth-child(7)  { height: 44px; animation-delay: .6s; }
    .frequency span:nth-child(8)  { height: 20px; animation-delay: .7s; }
    .frequency span:nth-child(9)  { height: 38px; animation-delay: .8s; }
    .frequency span:nth-child(10) { height: 48px; animation-delay: .9s; }
    .frequency span:nth-child(11) { height: 26px; animation-delay: 1s; }
    .frequency span:nth-child(12) { height: 40px; animation-delay: 1.1s; }
    .frequency span:nth-child(13) { height: 18px; animation-delay: 1.2s; }

    @keyframes frequency {
      0%,100% {
        transform: scaleY(.45);
        opacity: .4;
      }

      50% {
        transform: scaleY(1);
        opacity: .9;
      }
    }


    /* =========================================================
       FOOTER
    ========================================================= */

    footer {
      padding: 30px 40px;

      display: flex;

      justify-content: space-between;
      align-items: center;

      border-top: 1px solid var(--border);
    }

    .footer-brand {
      font-size: 10px;

      letter-spacing: .14em;

      text-transform: uppercase;

      color: var(--faint);
    }

    .socials {
      display: flex;

      gap: 22px;
    }

    .socials a {
      font-size: 9px;

      letter-spacing: .12em;

      text-transform: uppercase;

      color: var(--muted);

      transition: color .2s ease;
    }

    .socials a:hover {
      color: var(--white);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 900px) {

      .container {
        width: min(
          calc(100% - 40px),
          var(--max)
        );
      }

      nav {
        padding: 20px;
      }

      .nav-links {
        display: none;
      }

      .nav-right {
        gap: 0;
      }

      .page-hero {
        min-height: 48vh;
      }

      .page-hero-content {
        padding: 100px 0 65px;
      }

      .page-title {
        font-size: clamp(
          60px,
          18vw,
          110px
        );
      }

      .page-intro {
        font-size: 14px;
      }

      .sets {
        padding: 80px 0 100px;
      }

      .sets-header {
        display: block;
      }

      .sets-header-description {
        margin-top: 25px;
      }

      .featured-top {
        grid-template-columns: 1fr;
      }

      .featured-visual {
        min-height: 380px;
      }

      .featured-info {
        border-left: 0;

        border-top: 1px solid var(--border);

        padding: 36px;
      }

      .set-grid {
        grid-template-columns: 1fr;
      }

      .connection {
        margin-top: 80px;

        padding: 100px 0;
      }

      footer {
        padding: 25px 20px;

        flex-direction: column;

        gap: 20px;
      }
    }


    @media (max-width: 520px) {

      .logo img {
        height: 32px;
      }

      .nav-button {
        padding: 9px 13px;
      }

      .page-hero {
        min-height: 45vh;
      }

      .page-hero-content {
        padding: 90px 0 55px;
      }

      .page-intro {
        margin-top: 30px;

        font-size: 13px;
      }

      .sets {
        padding: 70px 0 80px;
      }

      .sets-heading {
        font-size: 42px;
      }

      .featured-visual {
        min-height: 300px;
      }

      .visual-ring {
        width: 240px;
        height: 240px;
      }

      .visual-center {
        width: 80px;
        height: 80px;
      }

      .featured-info {
        padding: 28px;
      }

      .featured-title {
        font-size: 34px;
      }

      .featured-meta {
        gap: 22px;

        flex-wrap: wrap;
      }

      .player-label {
        padding: 15px 18px;
      }

      .player-platform {
        display: none;
      }

      .soundcloud-frame {
        height: 166px;
      }

      .more-sets {
        margin-top: 70px;
      }

      .connection {
        padding: 85px 0;
      }

      .connection-title {
        font-size: 58px;
      }

      .connection-description {
        font-size: 13px;
      }

      .socials {
        flex-wrap: wrap;

        justify-content: center;
      }
    }

  </style>
</head>


<body>

  <!-- =======================================================
       COLOR LINE
  ======================================================== -->

  <div class="pulse-line"></div>


  <!-- =======================================================
       NAVIGATION
  ======================================================== -->

  <nav>

    <a href="index.html" class="logo">
      <img
        src="logo.png"
        alt="WeAreParty"
      />
    </a>

    <div class="nav-right">

      <ul class="nav-links">

        <li>
          <a href="sets.html" class="active">
            Sets
          </a>
        </li>

        <li>
          <a href="index.html#eventos">
            Eventos
          </a>
        </li>

        <li>
          <a href="index.html#comunidad">
            Comunidad
          </a>
        </li>

        <li>
          <a href="filosofia.html">
            Filosofía
          </a>
        </li>

      </ul>

      <a
        href="index.html#contacto"
        class="nav-button"
      >
        Entrar
      </a>

    </div>

  </nav>


  <!-- =======================================================
       PAGE HERO
  ======================================================== -->

  <header class="page-hero">

    <div class="page-hero-background">

      <div class="glow-1"></div>
      <div class="glow-2"></div>

      <div class="hero-grid"></div>

    </div>


    <div class="container">

      <div class="page-hero-content">

        <div class="eyebrow">
          WEAREPARTY / AUDIO
        </div>

        <h1 class="page-title">
          <span>SETS</span>
        </h1>

